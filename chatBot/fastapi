@app.post("/collection/backup")
async def backup_collection(backup_name: str = Query(..., description="Nom de la sauvegarde")):
    """
    Créer une sauvegarde de la collection
    """
    try:
        backup_path = f"./backups/{backup_name}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
