        if success:
            return {
                "success": True,
                "message": "Sauvegarde créée avec succès",
                "backup_path": backup_path
            }
        else:
            raise HTTPException(status_code=500, detail="Erreur lors de la sauvegarde")
            
    except Exception as e:
        logger.error(f"Erreur lors de la sauvegarde: {e}")
        raise HTTPException(status_code=500, detail=f"Erreur: {str(e)}")

@app.get("/search/similar/{document_id}")
async def find_similar_documents(
    document_id: str,
    k: int = Query(default=5, ge=1, le=50),
    include_original: bool = Query(default=False)
):
    """
    Trouver des documents similaires à un document existant
    """
    try:
        # Récupérer le document original
        search_results = vectorstore.client.retrieve(
            collection_name=vectorstore.collection_name,
            ids=[document_id],
            with_payload=True,
            with_vectors=True
        )
        
        if not search_results:
            raise HTTPException(status_code=404, detail="Document non trouvé")
        
        original_doc = search_results[0]
        
        # Rechercher des documents similaires
        similar_results = vectorstore.client.search(
            collection_name=vectorstore.collection_name,
            query_vector=original_doc.vector,
            limit=k + 1 if not include_original else k,
            with_payload=True,
            with_vectors=False
        )
        
        # Filtrer le document original si nécessaire
        if not include_original:
            similar_results = [r for r in similar_results if r.id != document_id][:k]
        
        # Formater les résultats
        results = [
            {
                "id": result.id,
                "text": result.payload.get("text", ""),
                "metadata": {k: v for k, v in result.payload.items() if k != "text"},
                "score": result.score
            }
            for result in similar_results
        ]
        
        return {
            "original_document_id": document_id,
            "similar_documents": results,
            "total_results": len(results)
        }
        
    except Exception as e:
        logger.error(f"Erreur lors de la recherche de similaires: {e}")
        raise HTTPException(status_code=500, detail=f"Erreur: {str(e)}")

@app.get("/documents/by-filter")
async def get_documents_by_filter(
    filename: Optional[str] = Query(default=None),
    category: Optional[str] = Query(default=None),
    file_extension: Optional[str] = Query(default=None),
    limit: int = Query(default=10, ge=1, le=100)
):
    """
    Récupérer des documents selon des critères de filtrage
    """
    try:
        # Construire les conditions de filtre
        filter_conditions = {}
        if filename:
            filter_conditions["filename"] = filename
        if category:
            filter_conditions["category"] = category
        if file_extension:
            filter_conditions["file_extension"] = file_extension
        
        if not filter_conditions:
            raise HTTPException(status_code=400, detail="Au moins un critère de filtre requis")
        
        # Effectuer une recherche avec filtre (en utilisant un vecteur neutre)
        import numpy as np
        neutral_vector = np.zeros(vectorstore.vector_size).tolist()
        
        from qdrant_client.http import models
        query_filter = models.Filter(
            must=[
                models.FieldCondition(
                    key=key,
                    match=models.MatchValue(value=value)
                )
                for key, value in filter_conditions.items()
            ]
        )
        
        results = vectorstore.client.search(
            collection_name=vectorstore.collection_name,
            query_vector=neutral_vector,
            limit=limit,
            query_filter=query_filter,
            with_payload=True,
            with_vectors=False
        )
        
        # Formater les résultats
        formatted_results = [
            {
                "id": result.id,
                "text": result.payload.get("text", "")[:200] + "...",
                "metadata": {k: v for k, v in result.payload.items() if k != "text"}
            }
            for result in results
        ]
        
        return {
            "filter_conditions": filter_conditions,
            "documents": formatted_results,
            "total_results": len(formatted_results)
        }
        
    except Exception as e:
        logger.error(f"Erreur lors du filtrage: {e}")
        raise HTTPException(status_code=500, detail=f"Erreur: {str(e)}")

